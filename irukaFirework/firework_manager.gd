extends Node2D


# =========================================================
# 花火シーン
# =========================================================

const FIREWORK_SCENE: PackedScene = preload(
	"res://irukaFirework/firework.tscn"
)


# =========================================================
# 通常時
# =========================================================

var sequence_timer: float = 0.8

var sequence_running: bool = false


# =========================================================
# フィナーレ状態
# =========================================================

var finale_started: bool = false

var finale_finished: bool = false


# =========================================================
# 初期化
# =========================================================

func _ready() -> void:

	randomize()

	# -----------------------------------------------------
	# 最初の花火
	# -----------------------------------------------------

	await get_tree().create_timer(
		0.4
	).timeout

	launch_firework()


	await get_tree().create_timer(
		0.22
	).timeout

	launch_firework()


	await get_tree().create_timer(
		0.32
	).timeout

	launch_firework()


# =========================================================
# 通常更新
# =========================================================

func _process(delta: float) -> void:

	# -----------------------------------------------------
	# フィナーレ中は通常打ち上げを止める
	# -----------------------------------------------------

	if finale_started:

		return


	# -----------------------------------------------------
	# 通常花火
	# -----------------------------------------------------

	sequence_timer -= delta


	if sequence_timer <= 0.0:

		if not sequence_running:

			start_sequence()

			sequence_timer = randf_range(
				0.8,
				2.2
			)


# =========================================================
# 通常連発
# =========================================================

func start_sequence() -> void:

	if sequence_running:

		return


	sequence_running = true


	var count: int = randi_range(
		2,
		4
	)


	for i: int in range(count):

		launch_firework()


		if i < count - 1:

			await get_tree().create_timer(
				randf_range(
					0.08,
					0.30
				)
			).timeout


	sequence_running = false


# =========================================================
# 通常花火1発
# =========================================================

func launch_firework() -> void:

	var firework: Node2D = (
		FIREWORK_SCENE.instantiate()
	)

	add_child(firework)


# =========================================================
# フィナーレ開始
# =========================================================

func start_finale() -> void:

	# -----------------------------------------------------
	# 二重実行防止
	# -----------------------------------------------------

	if finale_started:

		return


	finale_started = true


	# -----------------------------------------------------
	# 通常連発を停止
	# -----------------------------------------------------

	sequence_running = true


	# =====================================================
	# 第1波
	# =====================================================

	await finale_wave_one()


	# =====================================================
	# 第2波
	# =====================================================

	await finale_wave_two()


	# =====================================================
	# 第3波
	# =====================================================

	await finale_wave_three()


	# =====================================================
	# 最終爆発
	# =====================================================

	await finale_last_burst()


	finale_finished = true


# =========================================================
# フィナーレ第1波
# =========================================================

func finale_wave_one() -> void:

	for i: int in range(10):

		launch_finale_firework()


		await get_tree().create_timer(
			randf_range(
				0.08,
				0.16
			)
		).timeout


# =========================================================
# フィナーレ第2波
# =========================================================

func finale_wave_two() -> void:

	for i: int in range(18):

		launch_finale_firework()


		await get_tree().create_timer(
			randf_range(
				0.045,
				0.11
			)
		).timeout


# =========================================================
# フィナーレ第3波
# =========================================================

func finale_wave_three() -> void:

	for i: int in range(30):

		launch_finale_firework()


		await get_tree().create_timer(
			randf_range(
				0.025,
				0.075
			)
		).timeout


# =========================================================
# 最終爆発
# =========================================================

func finale_last_burst() -> void:

	# -----------------------------------------------------
	# 40発怒涛の連発
	# -----------------------------------------------------

	for i: int in range(40):

		launch_finale_firework()


		await get_tree().create_timer(
			randf_range(
				0.015,
				0.055
			)
		).timeout


	# -----------------------------------------------------
	# 最後の一斉発射
	# -----------------------------------------------------

	for i: int in range(15):

		launch_finale_firework()


	# -----------------------------------------------------
	# 少し待つ
	# -----------------------------------------------------

	await get_tree().create_timer(
		2.0
	).timeout


# =========================================================
# フィナーレ用花火
# =========================================================

func launch_finale_firework() -> void:

	var firework: Node2D = (
		FIREWORK_SCENE.instantiate()
	)


	add_child(firework)
