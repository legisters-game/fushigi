@icon("res://拡張リソース/アイコン/拡張ノード/NPC制御.png")
extends Node3D
class_name スケジュール管理クラス

@export var 全体スケジュール:Dictionary[NPC,NPCスケジューラ]
@export var 太陽:時間太陽
@export var メッセージボックス:メッセージボックスクラス
var ソート停止:Dictionary[NPC,Array]={}
enum NPC{キール,リュー,キング,ヒジキ,リッド,すね,リウス,ちゃいにー,いるか,ななし,かるかん,いきぱら,タック,リッター,わでいど}

# Called when the node enters the scene tree for the first time.

#直接ミッションを参照しに行って、オーバーライドがあるか確認する、重複する場合は有線順位で判断する。
func 目的地取得(対象: NPC) -> Dictionary[String, Variant]:
	var 基本辞書無し:bool
	var 返す辞書: Dictionary[String, Variant] = {"目的地": Vector3.ZERO, "強制到着": false,"ディメンション":""}
	if not 全体スケジュール.has(対象):
		基本辞書無し=true

	var 現在時刻:float = 太陽.現時間
	
	# 1. 既存のソート停止（強制到着）状態の確認
	if ソート停止 and ソート停止.has(対象) and ソート停止[対象] and ソート停止[対象][0]:
		if ソート停止[対象][1] < 現在時刻:
			ソート停止[対象][0] = false
		else:
			return {"目的地": ソート停止[対象][2], "強制到着": true,"ディメンション":ソート停止[対象][3],"ディメンションオブジェクト番号":ソート停止[対象][4]}


	var リスト: Array = 全体スケジュール[対象].スケジュールリスト
	
	# 2. 全予定の中から「現在の時間」に最も適したものを探す
	var 次の予定: セルスケジュール = null
	var 最小距離:float = 2.0 # 1.0より大きければ何でもよい
	var デフォルト範囲内:bool
	
	for i:セルスケジュール in リスト:
		# 現在が期間内なら即座に決定
		var is_in_range:bool = false
		if i.開始時間 < i.終了時間: # 通常
			is_in_range = (現在時刻 >= i.開始時間 and 現在時刻 < i.終了時間)
		else: # 日またぎ
			is_in_range = (現在時刻 >= i.開始時間 or 現在時刻 < i.終了時間)
		
		if is_in_range:
			返す辞書["目的地"] = i.目的置
			返す辞書["ディメンション"]=i.ディメンション
			返す辞書["ディメンションオブジェクト番号"]=i.ディメンションオブジェクト番号
			#返す辞書["強制到着"] = true
			ソート停止[対象] = [true, i.終了時間, i.目的置,i.ディメンション,i.ディメンションオブジェクト番号]
			#return 返す辞書
			デフォルト範囲内=true
			break
			
		# 期間外の場合、「最も近い未来」を探す（距離計算）
		var 距離:float = i.開始時間 - 現在時刻
		if 距離 < 0: 距離 += 1.0 # ループ対応
		
		if 距離 < 最小距離:
			最小距離 = 距離
			次の予定 = i

	# 3. 予定が確定
	if 次の予定:
		返す辞書["目的地"] = 次の予定.目的置
		
	return 返す辞書

	
	
func メッセージ取得(対象: NPC) -> Array[セリフオブジェクト]:
	var 欲しいメッセージ: Array[セリフオブジェクト] = []
	var 現在時刻: float = 太陽.現時間
	
	# ----------------------------------------------------
	# 1. ミッションスケジュール（追加・上書き用）の判定（最優先）
	# ----------------------------------------------------
	var ミッションの次の予定: セルスケジュール = null
	var ミッション最小距離: float = 2.0
	
	for スケジューラ in get_tree().get_first_node_in_group("UI").get_node("ミッションマネージャー").キャラスケジュール取得(対象):
		for スケジュール: セルスケジュール in スケジューラ.スケジュールリスト:
			var is_in_range: bool = false
			if スケジュール.開始時間 < スケジュール.終了時間:
				is_in_range = (現在時刻 >= スケジュール.開始時間 and 現在時刻 < スケジュール.終了時間)
			else:
				is_in_range = (現在時刻 >= スケジュール.開始時間 or 現在時刻 < スケジュール.終了時間)
			
			# 現在時刻が時間内であれば、ミッションのセリフで即確定（通常を完全オーバーライド）
			if is_in_range:
				return スケジュール.セリフ
			
			# 未来の予定の距離計算
			var 距離: float = スケジュール.開始時間 - 現在時刻
			if 距離 < 0: 距離 += 1.0
			
			if 距離 < ミッション最小距離:
				ミッション最小距離 = 距離
				ミッションの次の予定 = スケジュール

	# ----------------------------------------------------
	# 2. 全体スケジュール（通常用）の判定
	# ----------------------------------------------------
	if not 全体スケジュール.has(対象):
		# 全体スケジュールがなくても、ミッションの未来予定があればそれを返す
		if ミッションの次の予定:
			return ミッションの次の予定.セリフ
		return 欲しいメッセージ

	var リスト: Array = 全体スケジュール[対象].スケジュールリスト
	var 通常の次の予定: セルスケジュール = null
	var 通常最小距離: float = 2.0
	
	for i: セルスケジュール in リスト:
		var is_in_range: bool = false
		if i.開始時間 < i.終了時間:
			is_in_range = (現在時刻 >= i.開始時間 and 現在時刻 < i.終了時間)
		else:
			is_in_range = (現在時刻 >= i.開始時間 or 現在時刻 < i.終了時間)
		
		# 通常の現在時刻に該当する場合
		if is_in_range:
			return i.セリフ
		
		var 距離: float = i.開始時間 - 現在時刻
		if 距離 < 0: 距離 += 1.0
		
		if 距離 < 通常最小距離:
			通常最小距離 = 距離
			通常の次の予定 = i

	# ----------------------------------------------------
	# 3. 現在時刻に該当する予定がどちらにもなかった場合（未来予定の比較）
	# ----------------------------------------------------
	# ミッションの未来予定と通常の未来予定を比較し、より近い未来（またはミッション優先）を採用
	if ミッションの次の予定 and 通常の次の予定:
		# ミッションの未来予定の方が現在時刻に近い（または同等）ならオーバーライド
		if ミッション最小距離 <= 通常最小距離:
			return ミッションの次の予定.セリフ
		else:
			return 通常の次の予定.セリフ
	elif ミッションの次の予定:
		return ミッションの次の予定.セリフ
	elif 通常の次の予定:
		return 通常の次の予定.セリフ

	return 欲しいメッセージ

func NPC取得(番号:NPC)->エンティティ:
	for ノード:Node3D in get_children():
		if ノード is NPCクラス and ノード.キャラ==番号:
			return ノード
	return null
