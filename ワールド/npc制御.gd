@icon("res://拡張リソース/アイコン/拡張ノード/NPC制御.png")
extends Node3D
class_name スケジュール管理クラス

@onready var レベル制御:レベル制御クラス=$"../"

@export var 全体スケジュール:Dictionary[NPC,NPCスケジューラ]
@export var NPCシーン:Dictionary[NPC,PackedScene]
@export var 太陽:時間太陽
@export var メッセージボックス:メッセージボックスクラス
var ソート停止:Dictionary[NPC,Array]={}
enum NPC{キール,リュー,キング,ヒジキ,リッド,すね,リウス,ちゃいにー,いるか,ななし,かるかん,いきぱら,タック,リッター,わでいど}

func _ready() -> void:
	await get_tree().create_timer(2).timeout
	while true:
		await get_tree().create_timer(2).timeout
		NPC再出現判断()

#直接ミッションを参照しに行って、オーバーライドがあるか確認する、重複する場合は優先順位で判断する。
func 目的地取得(対象: NPC) -> Dictionary[String, Variant]:
	var 返す辞書: Dictionary[String, Variant] = {"目的地": Vector3.ZERO, "強制到着": false, "ディメンション": ""}
	var 現在時刻: float = 太陽.現時間
	
	# ----------------------------------------------------
	# 0. 既存のソート停止（強制到着）状態の確認
	# ----------------------------------------------------
	if ソート停止 and ソート停止.has(対象) and ソート停止[対象] and ソート停止[対象][0]:
		if ソート停止[対象][1] < 現在時刻 :#どこかでソート停止を強制上書きする。
			ソート停止[対象][0] = false
		else:
			return {"目的地": ソート停止[対象][2], "強制到着": true, "ディメンション": ソート停止[対象][3], "ディメンションオブジェクト番号": ソート停止[対象][4]}
	
	# ----------------------------------------------------
	# 1. ミッションスケジュール（追加・上書き用）の判定（最優先）
	# ----------------------------------------------------
	var ミッションの次の予定: セルスケジュール = null
	var ミッション最小距離: float = 2.0
	
	for スケジューラ in レベル制御.GUI.ミッションGUI.キャラスケジュール取得(対象):
		for スケジュール: セルスケジュール in スケジューラ.スケジュールリスト:
			var 時間内ヒット: bool = false
			if スケジュール.開始時間 < スケジュール.終了時間:
				時間内ヒット = (現在時刻 >= スケジュール.開始時間 and 現在時刻 < スケジュール.終了時間)
			else:
				時間内ヒット = (現在時刻 >= スケジュール.開始時間 or 現在時刻 < スケジュール.終了時間)
			
			# 現在時刻が時間内であれば、ミッションの目的地で即確定（通常を完全オーバーライド）
			if 時間内ヒット:
				返す辞書["目的地"] = スケジュール.目的置
				返す辞書["ディメンション"] = スケジュール.ディメンション
				返す辞書["ディメンションオブジェクト番号"] = スケジュール.ディメンションオブジェクト番号
				ソート停止[対象] = [true, スケジュール.終了時間, スケジュール.目的置, スケジュール.ディメンション, スケジュール.ディメンションオブジェクト番号]
				return 返す辞書
			
			var 距離: float = スケジュール.開始時間 - 現在時刻
			if 距離 < 0: 距離 += 1.0
			
			if 距離 < ミッション最小距離:
				ミッション最小距離 = 距離
				ミッションの次の予定 = スケジュール
	
	# ----------------------------------------------------
	# 2. 全体スケジュール（通常用）の判定
	# ----------------------------------------------------
	var 基本辞書無し: bool = not 全体スケジュール.has(対象)
	var リスト: Array = [] if 基本辞書無し else 全体スケジュール[対象].スケジュールリスト
	var 通常の次の予定: セルスケジュール = null
	var 通常最小距離: float = 2.0
	
	for スケジュール: セルスケジュール in リスト:
		var 時間内ヒット: bool = false
		if スケジュール.開始時間 < スケジュール.終了時間:
			時間内ヒット = (現在時刻 >= スケジュール.開始時間 and 現在時刻 < スケジュール.終了時間)
		else:
			時間内ヒット = (現在時刻 >= スケジュール.開始時間 or 現在時刻 < スケジュール.終了時間)
		
		if 時間内ヒット:
			返す辞書["目的地"] = スケジュール.目的置
			返す辞書["ディメンション"] = スケジュール.ディメンション
			返す辞書["ディメンションオブジェクト番号"] = スケジュール.ディメンションオブジェクト番号
			ソート停止[対象] = [true, スケジュール.終了時間, スケジュール.目的置, スケジュール.ディメンション, スケジュール.ディメンションオブジェクト番号]
			return 返す辞書
		
		var 距離: float = スケジュール.開始時間 - 現在時刻
		if 距離 < 0: 距離 += 1.0
		
		if 距離 < 通常最小距離:
			通常最小距離 = 距離
			通常の次の予定 = スケジュール
	
	# ----------------------------------------------------
	# 3. 現在時刻に該当する予定がどちらにもなかった場合（未来予定の比較）
	# ----------------------------------------------------
	if ミッションの次の予定 and 通常の次の予定:
		if ミッション最小距離 <= 通常最小距離:
			返す辞書["目的地"] = ミッションの次の予定.目的置
		else:
			返す辞書["目的地"] = 通常の次の予定.目的置
	elif ミッションの次の予定:
		返す辞書["目的地"] = ミッションの次の予定.目的置
	elif 通常の次の予定:
		返す辞書["目的地"] = 通常の次の予定.目的置
	
	return 返す辞書

	
	
func メッセージ取得(対象: NPC) -> Array[セリフオブジェクト]:
	var 欲しいメッセージ: Array[セリフオブジェクト] = []
	var 現在時刻: float = 太陽.現時間
	
	# ----------------------------------------------------
	# 1. ミッションスケジュール（追加・上書き用）の判定（最優先）
	# ----------------------------------------------------
	var ミッションの次の予定: セルスケジュール = null
	var ミッション最小距離: float = 2.0
	
	for スケジューラ in レベル制御.GUI.ミッションGUI.キャラスケジュール取得(対象):
		for スケジュール: セルスケジュール in スケジューラ.スケジュールリスト:
			var 時間内ヒット: bool = false
			if スケジュール.開始時間 < スケジュール.終了時間:
				時間内ヒット = (現在時刻 >= スケジュール.開始時間 and 現在時刻 < スケジュール.終了時間)
			else:
				時間内ヒット = (現在時刻 >= スケジュール.開始時間 or 現在時刻 < スケジュール.終了時間)
			
			# 現在時刻が時間内であれば、ミッションのセリフで即確定（通常を完全オーバーライド）
			if 時間内ヒット:
				return スケジュール.セリフ
			
			# 未来の予定の距離計算
			var 距離: float = スケジュール.開始時間 - 現在時刻
			if 距離 < 0: 距離 += 1.0
			
			if 距離 < ミッション最小距離:
				ミッション最小距離 = 距離
				ミッションの次の予定 = スケジュール

	# ----------------------------------------------------
	# 2. 全体スケジュール（通常用）の判定
	# ----------------------------------------------------
	if not 全体スケジュール.has(対象):
		# 全体スケジュールがなくても、ミッションの未来予定があればそれを返す
		if ミッションの次の予定:
			return ミッションの次の予定.セリフ
		return 欲しいメッセージ

	var リスト: Array = 全体スケジュール[対象].スケジュールリスト
	var 通常の次の予定: セルスケジュール = null
	var 通常最小距離: float = 2.0
	
	for スケジュール: セルスケジュール in リスト:
		var 時間内ヒット: bool = false
		if スケジュール.開始時間 < スケジュール.終了時間:
			時間内ヒット = (現在時刻 >= スケジュール.開始時間 and 現在時刻 < スケジュール.終了時間)
		else:
			時間内ヒット = (現在時刻 >= スケジュール.開始時間 or 現在時刻 < スケジュール.終了時間)
		
		# 通常の現在時刻に該当する場合
		if 時間内ヒット:
			return スケジュール.セリフ
		
		var 距離: float = スケジュール.開始時間 - 現在時刻
		if 距離 < 0: 距離 += 1.0
		
		if 距離 < 通常最小距離:
			通常最小距離 = 距離
			通常の次の予定 = スケジュール

	# ----------------------------------------------------
	# 3. 現在時刻に該当する予定がどちらにもなかった場合（未来予定の比較）
	# ----------------------------------------------------
	# ミッションの未来予定と通常の未来予定を比較し、より近い未来（またはミッション優先）を採用
	if ミッションの次の予定 and 通常の次の予定:
		# ミッションの未来予定の方が現在時刻に近い（または同等）ならオーバーライド
		if ミッション最小距離 <= 通常最小距離:
			return ミッションの次の予定.セリフ
		else:
			return 通常の次の予定.セリフ
	elif ミッションの次の予定:
		return ミッションの次の予定.セリフ
	elif 通常の次の予定:
		return 通常の次の予定.セリフ

	return 欲しいメッセージ

func NPC取得(番号:NPC)->エンティティ:
	for ノード:Node3D in get_children():
		if ノード is NPCクラス and ノード.キャラ==番号:
			return ノード
	return null
	
	
func NPC再出現判断()->void:
	for NPC対象:NPC in NPC.size():
		var NPC名:String=NPC.find_key(NPC対象)
		if データロガー.フラグあるか(NPC名+"出現") and !get_node_or_null(NPC名):
			var NPC解凍シーン:PackedScene=NPCシーン.get(NPC対象)
			var NPCノード:NPCクラス=NPC解凍シーン.instantiate()
			NPCノード.キャラ=NPC対象
			NPCノード.name=NPC名
			add_child(NPCノード)
			#NPCノード.

func キャッシュ消去()->void:
	ソート停止={}
